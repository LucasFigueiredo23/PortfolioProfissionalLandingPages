// Deploy na Cloudflare Workers (somente arquivos estáticos).
// O build gera a pasta dist/ e a Cloudflare publica o que estiver nela.
{
  // Mesmo nome do Worker publicado na Cloudflare,
  // senão o deploy cria um Worker novo (com outra URL).
  "name": "portfolioprofissionallandingpages",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
