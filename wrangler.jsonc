// Deploy na Cloudflare Workers (somente arquivos estáticos).
// O build gera a pasta dist/ e a Cloudflare publica o que estiver nela.
{
  // ⚠️ Use o MESMO nome do Worker que já está publicado,
  // senão a Cloudflare cria um Worker novo (com outra URL).
  "name": "portfolio-profissional",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
